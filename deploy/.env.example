# ── Domain names ─────────────────────────────────────────────────────────────
# Leave blank to auto-derive from the server's public IP via nip.io, e.g.
#   app:  shop.123.45.67.89.nip.io     crm:  crm.123.45.67.89.nip.io
# (nip.io resolves any <x>.<ip>.nip.io to that IP — no DNS records needed).
# To use real domains instead, set both and point A records at the server.
APP_DOMAIN=
CRM_DOMAIN=
# Public https URLs (used for NextAuth + Paystack callbacks + sitemap).
# Leave blank to auto-derive from the domains above.
APP_PUBLIC_URL=
CRM_PUBLIC_URL=

# ── Postgres (compose db service) ─────────────────────────────────────────────
POSTGRES_USER=jojjy
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jojjy
POSTGRES_PORT=5433

# ── Runtime DB connection (inside the compose network — hostname `db`) ────────
APP_DATABASE_URL=postgresql://jojjy:change-me-strong-password@db:5432/jojjy?sslmode=disable
APP_DIRECT_URL=postgresql://jojjy:change-me-strong-password@db:5432/jojjy?sslmode=disable

# ── Build-time DB connection (host-reachable — used by `next build` ISR pages) ─
BUILD_DATABASE_URL=postgresql://jojjy:change-me-strong-password@localhost:5433/jojjy?sslmode=disable
BUILD_DIRECT_URL=postgresql://jojjy:change-me-strong-password@localhost:5433/jojjy?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Paystack (required for checkout) ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Display / currency ────────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY=USD
KES_PER_USD=130
NEXT_PUBLIC_ARTIST_WHATSAPP_NUMBER=

# ── Email via Resend (optional) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_FORM_RECIPIENT_EMAIL=

# ── Cloudinary (optional — signed music + uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Music play-token secret (optional — falls back to NEXTAUTH_SECRET) ────────
MUSIC_PLAY_SECRET=
