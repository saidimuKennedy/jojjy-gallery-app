generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Series {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  slug            String            @unique
  description     String
  /// Exhibition-page copy (Phase 2): opening framing text for the collection page.
  introduction    String?
  artistStatement String?
  filmUrl         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  artworks        Artwork[]
  mediaFiles      SeriesMediaFile[]

  @@map("series")
}

/// Behind-the-scenes photos/video for a Series exhibition page (Phase 2).
model SeriesMediaFile {
  id           Int           @id @default(autoincrement())
  url          String
  type         MediaFileType
  description  String?
  thumbnailUrl String?
  order        Int           @default(0)
  seriesId     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  series       Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("series_media_files")
}

model Artwork {
  id               Int                @id @default(autoincrement())
  title            String
  artist           String
  category         String
  price            Decimal            @db.Decimal(10, 2)
  imageUrl         String
  description      String?
  dimensions       String?
  isAvailable      Boolean?           @default(true)
  /// Collector-facing status, richer than isAvailable (kept for backward
  /// compatibility with existing checkout/admin code). Sold/collected works
  /// stay visible on the site instead of disappearing.
  status           ArtworkStatus      @default(AVAILABLE)
  /// Phase 2 reserve-before-buy: set alongside status = RESERVED, cleared on
  /// expiry or completed purchase. Expiry release is an application-level job.
  reservedUntil    DateTime?
  reservedByUserId String?
  views            Int                @default(0)
  likes            Int                @default(0)
  medium           String
  year             Int
  seriesId         Int?
  inGallery        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  mediaFiles       ArtworkMediaFile[]
  series           Series?            @relation(fields: [seriesId], references: [id])
  reservedByUser   User?              @relation(fields: [reservedByUserId], references: [id])
  wishlistedBy     WishlistItem[]
  orderItems       OrderItem[]

  @@map("artworks")
}

model ArtworkMediaFile {
  id           Int           @id @default(autoincrement())
  url          String
  type         MediaFileType
  description  String?
  thumbnailUrl String?
  order        Int           @default(0)
  artworkId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  artwork      Artwork       @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@map("artwork_media_files")
}

model MediaBlogEntry {
  id           Int                @id @default(autoincrement())
  title        String
  shortDesc    String?
  type         MediaBlogEntryType
  externalLink String?
  thumbnailUrl String?            @db.VarChar(500)
  duration     String?            @db.VarChar(50)
  content      String?
  /// Editorial publication state: null = DRAFT (never public); set = published
  /// (public once reached). Existing rows are backfilled from createdAt.
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  mediaFiles   MediaBlogFile[]

  @@map("media_blog_entries")
}

model MediaBlogFile {
  id               Int            @id @default(autoincrement())
  url              String
  type             MediaFileType
  description      String?
  thumbnailUrl     String?
  order            Int            @default(0)
  mediaBlogEntryId Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  mediaBlogEntry   MediaBlogEntry @relation(fields: [mediaBlogEntryId], references: [id], onDelete: Cascade)

  @@map("media_blog_files")
}

model User {
  id                String         @id @default(uuid())
  username          String         @unique
  email             String         @unique
  passwordHash      String
  role              UserRole       @default(USER)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  orders            Order[]
  tickets           Ticket[]
  reservedArtworks  Artwork[]
  wishlist          WishlistItem[]
  eventRsvps        EventRsvp[]
  subscriberProfile Subscriber?
  memberships       Membership[]
  releaseUnlocks    ReleaseUnlock[]
  paidPlayQuotas    PaidPlayQuota[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

/// Ticketed event, managed from the CRM. Public site reads/lists published events.
model Event {
  id            Int              @id @default(autoincrement())
  title         String
  slug          String           @unique
  description   String?
  venue         String?
  imageUrl      String?
  startsAt      DateTime
  endsAt        DateTime?
  status        EventStatus      @default(DRAFT)
  /// Whether the event sells tickets or is RSVP-only. RSVP-only events must be
  /// explicit (badges, no checkout link) rather than inferred from having no
  /// ticket types.
  ticketMode    EventTicketMode  @default(TICKETED)
  /// Optional schedule: DRAFT auto-flips to PUBLISHED once publishAt passes.
  publishAt     DateTime?
  /// Phase 2 richer event page fields.
  directions    String?
  openingHours  String?
  artistTalkAt  DateTime?
  /// IANA timezone the event runs in; drives displayed times on tickets.
  timezone      String           @default("Africa/Nairobi")
  /// Short label shown on tickets, e.g. "Live event" or "Opening".
  category      String?
  /// One-line tagline shown on the ticket artwork, e.g. "People. Art. Sound. Together."
  tagline       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ticketTypes   TicketType[]
  announcements Announcement[]
  rsvps         EventRsvp[]
  mediaFiles    EventMediaFile[]
  pressMentions PressMention[]

  @@map("events")
}

/// Fan RSVP for an event (Phase 2 fan/supporter accounts).
model EventRsvp {
  id        String     @id @default(uuid())
  userId    String
  eventId   Int
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_rsvps")
}

/// Post-event archive photos/video (Phase 2), separate from pre-event `Event.imageUrl`.
model EventMediaFile {
  id           Int           @id @default(autoincrement())
  url          String
  type         MediaFileType
  description  String?
  thumbnailUrl String?
  order        Int           @default(0)
  eventId      Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_media_files")
}

/// Press coverage, optionally tied to a specific event (Phase 2 event archive).
model PressMention {
  id          Int       @id @default(autoincrement())
  title       String
  url         String
  publication String?
  publishedAt DateTime?
  eventId     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event?    @relation(fields: [eventId], references: [id])

  @@map("press_mentions")
}

/// Wishlist entry — a fan saving an artwork without buying it yet (Phase 2).
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  artworkId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
  @@map("wishlist_items")
}

/// A priced tier of tickets for an event (e.g. General Admission, VIP).
model TicketType {
  id               Int         @id @default(autoincrement())
  eventId          Int
  name             String
  description      String?
  price            Decimal     @db.Decimal(10, 2)
  quantity         Int
  quantitySold     Int         @default(0)
  /// Active (unexpired) reservations consuming this tier's allocation. Invariant:
  /// quantitySold + quantityReserved <= quantity at all times.
  quantityReserved Int         @default(0)
  salesStart       DateTime?
  salesEnd         DateTime?
  /// Archived tiers are hidden from sale but kept for history once they have
  /// orders/tickets. Never hard-deleted after first sale.
  archivedAt       DateTime?
  /// Access label printed on the ticket, e.g. "General Access" or "VIP Access".
  entryLabel       String?
  /// Premium tiers get the gold accent on the ticket stub.
  isPremium        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  orderItems       OrderItem[]
  reservations     TicketReservation[]

  @@map("ticket_types")
}

/// One issued ticket, owned by a buyer, redeemable at the door via `code`.
model Ticket {
  id                   String       @id @default(uuid())
  ticketTypeId         Int
  /// Nullable: guest checkout issues tickets without a User account.
  userId               String?
  orderId              String
  code                 String       @unique
  status               TicketStatus @default(VALID)
  /// Source of the ticket, so reporting can separate paid from complimentary
  /// issuance without re-deriving it from the order.
  source               TicketSource @default(PAID)
  /// Ticket-holder snapshot (defaults from buyer contact, per-attendee editable).
  holderName           String?
  holderEmail          String?
  checkedInAt          DateTime?
  /// CRM staff who recorded the current check-in state (null until checked in).
  checkedInByCrmUserId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  ticketType           TicketType   @relation(fields: [ticketTypeId], references: [id])
  user                 User?        @relation(fields: [userId], references: [id])
  order                Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("tickets")
}

/// A short-lived hold on ticket-type inventory created at checkout, before
/// payment. Consumed on paid/complimentary issuance; released on expiry or
/// failed/cancelled payment so capacity returns to the pool.
model TicketReservation {
  id           String            @id @default(uuid())
  ticketTypeId Int
  orderId      String
  quantity     Int
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime
  releasedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  ticketType   TicketType        @relation(fields: [ticketTypeId], references: [id])
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("ticket_reservations")
}

/// Merch item, managed from the CRM.
model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  category    String?
  isAvailable Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@map("products")
}

/// A purchasable size/color combination of a Product, each with its own stock and price.
model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  sku        String      @unique
  size       String?
  color      String?
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

/// Unified purchase record for tickets, merch, music, and artwork.
model Order {
  id              String          @id @default(uuid())
  /// Nullable: guest checkout never creates a User account.
  userId          String?
  status          OrderStatus     @default(PENDING)
  /// Payment state, separate from the order lifecycle (`status`) so guest
  /// complimentary orders can be NOT_REQUIRED while paid orders track the
  /// provider state independently. Merch/music/artwork statuses are unchanged.
  paymentStatus   PaymentStatus   @default(PENDING)
  /// Where the order came from. Complimentary issuance is zero-value and has no
  /// payment provider.
  source          OrderSource     @default(ONLINE)
  /// Nullable only for zero-value complimentary issuance; paid orders set
  /// PAYSTACK.
  paymentProvider PaymentProvider?
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  phoneNumber     String?
  /// Snapshot of the fulfilment contact as given at checkout (operator copy;
  /// never derived from the mutable User profile at fulfilment time).
  customerName    String?
  /// Guest buyer contact snapshots. Email is required for guest ticket checkout;
  /// phone is optional unless the payment method needs it.
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  deliveryNotes   String?
  paystackRef     String?         @unique
  /// Phase 2 delivery/logistics for physical items (merch, and later original
  /// artwork if the legacy artwork checkout is consolidated into Order).
  deliveryMethod  DeliveryMethod?
  deliveryAddress String?
  packaging       PackagingType?
  deliveryFee     Decimal?        @db.Decimal(10, 2)
  /// Amount/currency actually charged at Paystack when it differs from
  /// `amount`/`currency` (catalogue is USD; this Paystack account only
  /// settles in KES), used to validate the verified payment amount.
  paystackChargeAmount   Decimal? @db.Decimal(12, 2)
  paystackChargeCurrency String?
  /// Physical fulfilment state. Payment state lives in `status`; a PAID order
  /// is UNFULFILLED until an operator marks it here. Tickets/digital access
  /// complete at payment and never use this field.
  fulfilledAt     DateTime?
  /// Complimentary issuance attribution: the CRM staff actor and the required
  /// reason. Stored as a scalar in both schemas; the CRM schema adds the FK.
  issuedByCrmUserId String?
  issueReason       String?
  /// Guest ticket retrieval: a secure, unguessable token (emailed as a one-time
  /// link) so tickets are never exposed by sequential id or email-only lookup.
  retrievalToken          String?  @unique
  retrievalTokenExpiresAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?           @relation(fields: [userId], references: [id])
  items           OrderItem[]
  tickets         Ticket[]
  reservations    TicketReservation[]

  @@index([guestEmail])
  @@map("orders")
}

/// A single line item on an Order. Exactly one product reference is set,
/// matching `itemType` (PRODUCT | TICKET | ARTWORK | RELEASE | MEMBERSHIP_PASS).
model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  itemType         OrderItemType
  productVariantId Int?
  ticketTypeId     Int?
  artworkId        Int?
  releaseId        Int?
  membershipPlanId Int?
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(10, 2)
  /// Per-admission attendee snapshots for ticket items: [{ name, email }].
  /// One entry per issued ticket; falls back to the buyer contact when empty.
  attendees        Json?
  createdAt        DateTime        @default(now())
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  ticketType       TicketType?     @relation(fields: [ticketTypeId], references: [id])
  artwork          Artwork?        @relation(fields: [artworkId], references: [id])
  release          Release?        @relation(fields: [releaseId], references: [id])
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id])

  @@map("order_items")
}

/// Fan-facing announcement, authored in the CRM, optionally tied to an Event.
/// Delivery channels (on-site, email, WhatsApp) are tracked independently
/// since a single announcement may go out on more than one.
model Announcement {
  id             Int       @id @default(autoincrement())
  title          String
  body           String
  imageUrl       String?
  eventId        Int?
  publishedAt    DateTime?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  event          Event?    @relation(fields: [eventId], references: [id])

  @@map("announcements")
}

/// Fan opt-in for announcement delivery. Not the same as `User` — a fan can
/// subscribe to updates without creating a purchasing account. When a
/// logged-in User also opts in ("follow the artist", Phase 2), `userId`
/// links the two records.
model Subscriber {
  id             String           @id @default(uuid())
  email          String?          @unique
  phoneNumber    String?          @unique
  userId         String?          @unique
  status         SubscriberStatus @default(ACTIVE)
  subscribedAt   DateTime         @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([email])
  @@map("subscribers")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// Where an order came from. Existing orders default to ONLINE.
enum OrderSource {
  ONLINE
  CRM_COMPLIMENTARY
}

/// Payment state, kept separate from the order lifecycle. `status` keeps its
/// existing meaning for merch/music/artwork compatibility.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  NEEDS_ATTENTION
}

enum TicketSource {
  PAID
  COMPLIMENTARY
}

enum EventTicketMode {
  TICKETED
  RSVP_ONLY
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum PaymentProvider {
  PAYSTACK
}

enum OrderItemType {
  PRODUCT
  TICKET
  ARTWORK
  RELEASE
  MEMBERSHIP_PASS
}

enum RsvpStatus {
  GOING
  INTERESTED
  CANCELLED
}

enum DeliveryMethod {
  LOCAL_PICKUP
  NAIROBI_DELIVERY
  KENYA_SHIPPING
  INTERNATIONAL_SHIPPING
}

enum PackagingType {
  FRAMED
  ROLLED
}

enum ArtworkStatus {
  AVAILABLE
  RESERVED
  ON_EXHIBITION
  SOLD
  IN_PRIVATE_COLLECTION
}

enum MediaFileType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaBlogEntryType {
  VIDEO
  IMAGES
  AUDIO
  EXTERNAL_LINK
  BLOG_POST
}

enum UserRole {
  ADMIN
  USER
}

// ---------------------------------------------------------------------------
// Music module — catalogue in CRM; entitlements for gallery Users.
// ---------------------------------------------------------------------------

enum MusicPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MusicAccessMode {
  FREE
  PAID
  MEMBERS_ONLY
}

enum MusicReleaseType {
  SINGLE
  EP
  ALBUM
  LIVE_SESSION
  ACOUSTIC_SESSION
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReleaseUnlockSource {
  ORDER
  CRM_MANUAL
}

model Release {
  id            Int                @id @default(autoincrement())
  slug          String             @unique
  title         String
  description   String?
  artistNotes   String?
  studioNotes   String?
  coverImage    String?
  artistName    String             @default("Jojjy Gallery")
  releaseType   MusicReleaseType   @default(SINGLE)
  genre         String?
  publishStatus MusicPublishStatus @default(DRAFT)
  publishAt     DateTime?
  explicit      Boolean            @default(false)
  releaseDate   DateTime?
  playCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tracks        Track[]
  accessPolicy  AccessPolicy?
  unlocks       ReleaseUnlock[]
  paidPlayQuotas PaidPlayQuota[]
  orderItems    OrderItem[]

  @@map("music_releases")
}

model Track {
  id          Int      @id @default(autoincrement())
  releaseId   Int
  title       String
  trackNumber Int
  duration    Int?
  storageKey  String
  bitrate     Int?
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, trackNumber])
  @@map("music_tracks")
}

model AccessPolicy {
  id             Int             @id @default(autoincrement())
  releaseId      Int             @unique
  accessMode     MusicAccessMode @default(PAID)
  price          Decimal?        @db.Decimal(10, 2)
  currency       String          @default("USD")
  paidPlayLimit  Int             @default(3)
  updatedAt      DateTime        @updatedAt
  release        Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@map("music_access_policies")
}

model MembershipPlan {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  currency     String      @default("USD")
  durationDays Int
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  memberships  Membership[]
  orderItems   OrderItem[]

  @@map("music_membership_plans")
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String
  membershipPlanId   Int
  orderId            String?
  grantedByCrmUserId String?
  startedAt          DateTime         @default(now())
  expiresAt          DateTime
  status             MembershipStatus @default(ACTIVE)
  isFounding         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               MembershipPlan   @relation(fields: [membershipPlanId], references: [id])

  @@index([userId, status])
  @@map("music_memberships")
}

model ReleaseUnlock {
  id                 String              @id @default(uuid())
  userId             String
  releaseId          Int
  orderItemId        String?
  grantedByCrmUserId String?
  source             ReleaseUnlockSource
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  release            Release             @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([userId, releaseId])
  @@map("music_release_unlocks")
}

model PaidPlayQuota {
  id           String   @id @default(uuid())
  releaseId    Int
  userId       String?
  anonymousKey String?
  playCount    Int      @default(0)
  updatedAt    DateTime @updatedAt
  release      Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@unique([releaseId, anonymousKey])
  @@map("music_paid_play_quotas")
}

model StudioPageContent {
  id               Int      @id @default(1)
  heroTitle        String   @default("Step Inside the Studio")
  heroSubtitle     String
  relationshipLead String
  journeySteps     Json
  faq              Json
  updatedAt        DateTime @updatedAt

  @@map("music_studio_page_content")
}

// ---------------------------------------------------------------------------
// CRM staff auth
